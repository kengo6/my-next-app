// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int  @id     @default(cuid())
  password  String
  email     String  @unique
}

model Profile {
  id          Int  @id     @default(cuid())
  u_name      String
  u_birthday  String
  u_image     String
}
